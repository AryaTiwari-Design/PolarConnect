# Copy this file to .env before running Docker Compose if your laptop IP changes.
#
# Laptop access:
#   VITE_API_URL=http://localhost:8000/api
#
# Phone access on the same Wi-Fi/network:
#   replace 10.8.9.147 with your laptop IPv4 address from ipconfig.
VITE_API_URL=http://10.8.9.147:8000/api
VITE_USE_MOCK=false
POLAR_SECRET_KEY=local-development-secret-change-this-before-deployment
